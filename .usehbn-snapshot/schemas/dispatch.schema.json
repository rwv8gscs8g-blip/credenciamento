{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBN Self-Declared Dispatch",
  "description": "Projection of the YAML front matter from .hbn/dispatch/NNNN-*.md dispatch artifacts. The body is validated separately by G-DSP-FMT for the zsh-safe invariant.",
  "type": "object",
  "required": [
    "dispatch_id",
    "readback_id",
    "token_fp",
    "human_authorization",
    "scope",
    "action_plan"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]*$",
      "description": "Stable id matching the basename without .md."
    },
    "path": {
      "type": "string",
      "pattern": "^\\.hbn/dispatch/[0-9]{4}-[a-z0-9][a-z0-9-]*\\.md$"
    },
    "readback_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "token_fp": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "human_authorization": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "in_progress", "ready_for_execution", "executed", "superseded"]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": ["files_allowed", "files_forbidden"],
      "properties": {
        "files_allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "action_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
