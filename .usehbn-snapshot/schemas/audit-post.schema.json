{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBN Audit Post-Execution Record",
  "description": "Parecer da IA auditora sobre o diff git e a saida dos gates DEPOIS da execucao. Pre-requisito para fechamento da onda. Status: accepted (hearback Mauricio 2026-06-10). Promovido de Credenciamento/.hbn/schemas/audit-post (v1.0.0); generalizado: auditor_agent pinado por projeto.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_id",
    "readback_id",
    "auditor_agent",
    "verdict",
    "diff_summary",
    "gates_evidence",
    "findings",
    "recommendation",
    "signed_at"
  ],
  "properties": {
    "audit_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-post$"
    },
    "readback_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[a-z0-9-]+$"
    },
    "auditor_agent": {
      "type": "string",
      "minLength": 1,
      "description": "Identificador do agente auditor. Projetos DEVEM restringir a enum no schema local. Auditor nao pode ser o executor da onda (P10)."
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "warn", "fail"]
    },
    "diff_summary": {
      "type": "object",
      "required": ["files_touched", "files_outside_scope"],
      "additionalProperties": false,
      "properties": {
        "files_touched": { "type": "array", "items": { "type": "string" } },
        "files_outside_scope": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Arquivos tocados fora do scope.files_allowed do readback. Se nao-vazio, verdict deve ser 'fail'."
        },
        "lines_added": { "type": "integer", "minimum": 0 },
        "lines_removed": { "type": "integer", "minimum": 0 }
      }
    },
    "gates_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "status", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "gate": { "type": "string" },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "evidence_ref": { "type": "string", "description": "ID de verificacao, sha do commit, caminho do artefato de evidencia, etc." }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "category", "description"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "p0"] },
          "category": { "type": "string", "enum": ["scope_violation", "invariant_broken", "gate_red", "missing_evidence", "doctrinal_drift", "naming_drift", "other"] },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "enum": ["aceitar", "aceitar_com_debito", "revisar", "reverter"]
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
