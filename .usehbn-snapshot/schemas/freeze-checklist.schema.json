{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBN Freeze Checklist",
  "description": "Checklist estruturado de freeze de uma versão (ADR-017, core/freeze-gate-spec.md). Status: proposed (corrente D, 2026-06-10; hearback pendente). Gate: guards/freeze-gate.sh responde congelável sim/não.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checklist_id",
    "projeto",
    "versao_alvo",
    "bloqueadores_abertos",
    "criterios",
    "atualizado_por",
    "atualizado_em"
  ],
  "properties": {
    "checklist_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{2}-freeze-[a-z0-9.-]+$",
      "description": "Id global ADR-011 + slug da versão (ex.: 20260610-44-freeze-v12.0.0206)."
    },
    "projeto": { "type": "string", "minLength": 1 },
    "versao_alvo": { "type": "string", "minLength": 1, "description": "Ex.: V12.0.0206" },
    "bloqueadores_abertos": {
      "type": "integer",
      "minimum": 0,
      "description": "Contagem de findings severidade BLOQUEADOR abertos. > 0 = não congelável, sempre (veto, cadência D)."
    },
    "criterios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "descricao", "obrigatorio", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "descricao": { "type": "string", "minLength": 1 },
          "obrigatorio": { "type": "boolean" },
          "status": { "type": "string", "enum": ["ok", "pendente", "na"] },
          "evidencia": {
            "type": "string",
            "description": "Path/hash/id de teste que prova o ok (Truth Barrier). Obrigatória se status=ok."
          },
          "justificativa": {
            "type": "string",
            "description": "Obrigatória se status=na (por que o critério não se aplica)."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "ok" } } },
            "then": { "required": ["evidencia"] }
          },
          {
            "if": { "properties": { "status": { "const": "na" } } },
            "then": { "required": ["justificativa"] }
          }
        ]
      }
    },
    "atualizado_por": { "type": "string", "minLength": 1 },
    "atualizado_em": { "type": "string", "format": "date-time" }
  }
}
